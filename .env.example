# Copy this file to .env for Docker Compose. Replace the database password before use.
DB_USERNAME=devplus
DB_PASSWORD=replace-with-a-long-random-password
SESSION_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VITE_API_BASE_URL=/api/v1
